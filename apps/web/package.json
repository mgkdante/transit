{
	"name": "@transit/web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "node scripts/gen-contract.mjs && vite dev",
		"build": "node scripts/gen-contract.mjs && vite build",
		"preview": "vite preview",
		"prepare": "node scripts/gen-contract.mjs && (svelte-kit sync || echo '')",
		"check": "node scripts/gen-contract.mjs && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "node scripts/gen-contract.mjs && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"og:build": "bun scripts/build-og.ts",
		"og:check": "bun scripts/build-og.ts --check",
		"icons:build": "bun scripts/build-icons.ts",
		"icons:check": "bun scripts/build-icons.ts --check",
		"map-posters:build": "bun scripts/build-map-posters.ts",
		"map-posters:check": "bun scripts/build-map-posters.ts --check",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "node scripts/gen-contract.mjs && vitest run --maxWorkers=4",
		"test:e2e": "bun run build && playwright test -c e2e/playwright.config.ts",
		"test:b9-display": "node scripts/b9-displayed-values.mjs",
		"test:unit": "node scripts/gen-contract.mjs && vitest"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.12.1",
		"@csstools/postcss-global-data": "4.0.0",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "1.62.0",
		"@resvg/resvg-js": "^2.6.2",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.1.18",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^5.3.1",
		"@types/d3-scale": "^4.0.9",
		"@types/d3-shape": "^3.1.8",
		"@types/node": "^22",
		"@yesid/gates": "https://github.com/mgkdante/yesid.dev-design/releases/download/v0.28.1/yesid-gates-0.28.1.tgz",
		"@yesid/tokens": "https://github.com/mgkdante/yesid.dev-design/releases/download/v0.28.1/yesid-tokens-0.28.1.tgz",
		"bits-ui": "^2.16.3",
		"clsx": "^2.1.1",
		"eslint": "^10.5.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"happy-dom": "^21.0.4",
		"playwright-core": "1.62.0",
		"postcss-custom-media": "12.0.1",
		"prettier": "^3.8.4",
		"prettier-plugin-svelte": "^4.1.0",
		"rollup-plugin-visualizer": "^7.0.1",
		"satori": "^0.28.0",
		"sharp": "^0.35.3",
		"svelte": "^5.54.0",
		"svelte-check": "^4.4.2",
		"tailwindcss": "^4.1.18",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.61.0",
		"vite": "^7.3.6",
		"vitest": "^4.1.0"
	},
	"dependencies": {
		"@lucide/svelte": "^1.18.0",
		"@yesid/analytics": "https://github.com/mgkdante/yesid.dev-design/releases/download/v0.28.1/yesid-analytics-0.28.1.tgz",
		"@yesid/i18n-core": "https://github.com/mgkdante/yesid.dev-design/releases/download/v0.28.1/yesid-i18n-core-0.28.1.tgz",
		"@yesid/motion": "https://github.com/mgkdante/yesid.dev-design/releases/download/v0.28.1/yesid-motion-0.28.1.tgz",
		"@yesid/seo-kit": "https://github.com/mgkdante/yesid.dev-design/releases/download/v0.28.1/yesid-seo-kit-0.28.1.tgz",
		"@yesid/ui": "https://github.com/mgkdante/yesid.dev-design/releases/download/v0.28.1/yesid-ui-0.28.1.tgz",
		"d3-scale": "^4.0.2",
		"d3-shape": "^3.2.0",
		"gsap": "^3.15.0",
		"layerchart": "2.4.0",
		"maplibre-gl": "6.4.1",
