{
  "name": "@yesid/motion",
  "version": "0.13.3",
  "private": true,
  "type": "module",
  "description": "Pure brand motion actions extracted byte-faithful from yesid.dev @ 2bdb611d. Snappy Doctrine vocabulary (Tier 1): boop, magnetic, cursorGlow, sectionGlow, cardParallax, pressBounce, wordmarkHover + sectionMagnet. morphHover/scrollChain stay app-side (Tier 2).",
  "sideEffects": ["**/*.css"],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./actions": {
      "types": "./src/actions/index.ts",
      "default": "./src/actions/index.ts"
    },
    "./policy": {
      "types": "./src/policy.ts",
      "default": "./src/policy.ts"
    },
    "./tokens": {
      "types": "./src/tokens.ts",
      "default": "./src/tokens.ts"
    },
    "./stores/reducedMotion": {
      "types": "./src/stores/reducedMotion.ts",
      "default": "./src/stores/reducedMotion.ts"
    },
    "./utils/device": {
      "types": "./src/utils/device.ts",
      "default": "./src/utils/device.ts"
    },
    "./utils/globalRipple": {
      "types": "./src/utils/globalRipple.ts",
      "default": "./src/utils/globalRipple.ts"
    },
    "./utils/gsap": {
      "types": "./src/utils/gsap.ts",
      "default": "./src/utils/gsap.ts"
    },
    "./utils/lenis": {
      "types": "./src/utils/lenis.ts",
      "default": "./src/utils/lenis.ts"
    },
    "./utils/sectionMagnet": {
      "types": "./src/utils/sectionMagnet.ts",
      "default": "./src/utils/sectionMagnet.ts"
    },
    "./utils/ticker": {
      "types": "./src/utils/ticker.ts",
      "default": "./src/utils/ticker.ts"
    },
    "./ripple.css": "./ripple.css",
    "./tap-feedback.css": "./tap-feedback.css"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "gsap": "^3.14.2",
    "lenis": "^1.3.21"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "happy-dom": "^20.8.9",
    "svelte": "^5.54.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.0"
  }
}
