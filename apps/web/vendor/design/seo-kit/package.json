{
  "name": "@yesid/seo-kit",
  "version": "0.27.0",
  "private": true,
  "type": "module",
  "description": "Framework-neutral JSON-LD, sitemap and robots, share-card, icon and security-header primitives with consumer-owned policy and rasterization.",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./jsonld": {
      "types": "./src/jsonld.ts",
      "default": "./src/jsonld.ts"
    },
    "./sitemap": {
      "types": "./src/sitemap.ts",
      "default": "./src/sitemap.ts"
    },
    "./satori": {
      "types": "./src/satori.ts",
      "default": "./src/satori.ts"
    },
    "./og": {
      "types": "./src/og.ts",
      "default": "./src/og.ts"
    },
    "./og/fonts": {
      "types": "./src/og-fonts.ts",
      "default": "./src/og-fonts.ts"
    },
    "./og/files": {
      "types": "./src/og-files.ts",
      "default": "./src/og-files.ts"
    },
    "./icons": {
      "types": "./src/icons.ts",
      "default": "./src/icons.ts"
    },
    "./headers": {
      "types": "./src/headers.ts",
      "default": "./src/headers.ts"
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@yesid/tokens": "file:../tokens"
  },
  "peerDependencies": {
    "satori": ">=0.10.0 <1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "satori": "^0.28.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.0"
  }
}
