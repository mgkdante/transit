# Cloudflare _headers — response headers by path.
#
# adapter-cloudflare copies this file to the deploy root. First matching
# rule per header wins. Keep this in lockstep with the deployment guide:
# https://www.notion.so/3ea3e86306908143886fdfc58ff24cd9
#
# CACHE DOCTRINE
#   /_app/immutable/*  content-hashed by SvelteKit  -> immutable, 1 year
#   /og/*.png          rebuilt only when copy changes -> 1 day CDN, swr 1 week
#   /favicon.svg       stable brand mark              -> 1 week
#   /data/*            LIVE snapshot contract         -> NEVER cached here
#                      (compatibility route only; primary reads use the R2
#                       custom domain and its object freshness headers)

# Hashed build assets — safe to cache forever (filename changes on every edit).
/_app/immutable/*
  Cache-Control: public, max-age=31536000, immutable

# Open Graph cards — regenerated by scripts/build-og.ts only when copy changes.
# Short CDN TTL + stale-while-revalidate keeps social scrapers fast without
# pinning a stale card for a year.
/og/*
  Cache-Control: public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800

# Brand favicon — stable, modest TTL.
/favicon.svg
  Cache-Control: public, max-age=604800

# Live snapshot contract — NEVER cached at this edge. Belt-and-suspenders:
# /data/* is served by the compatibility zone-route worker (dev proxy in
# vite.config.ts), so this app should not normally emit /data/* itself — but if
# anything ever does, refuse to cache it. Freshness is the worker's job.
/data/*
  Cache-Control: no-store

# PWA remote kill-switch flag — MUST never be edge-cached, or the operator could
# not remotely disable a misbehaving service worker (a cached flag would pin the
# old value). The SW + client both fetch it with cache:'no-store'; belt-and-
# suspenders, refuse to cache it at the edge too.
/sw-kill.json
  Cache-Control: no-store

# Service worker script — keep the registration short-lived so a new deploy (and
# any fix / the in-SW kill logic) is picked up promptly rather than pinned.
/service-worker.js
  Cache-Control: public, max-age=0, must-revalidate

# Offline fallback — content-stable shell page; modest TTL.
/offline
  Cache-Control: public, max-age=3600

# Baseline security headers for static ASSET responses (favicon, fonts,
# /_app/immutable). In Worker mode `_headers` only decorates assets — SSR
# documents get the same headers from hooks.server.ts and the CSP, plus inline
# script hashes, from kit.csp in svelte.config.js. securityHeaders.test.ts keeps
# them in lockstep.
# NOTE: img-src is narrowed off the old `https:` wildcard to 'self' data: blob:
# + the basemap host (defense-in-depth) + the OG-image origin. Cross-Origin-
# Resource-Policy is intentionally omitted (it would block social OG scrapes).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: accelerometer=(), bluetooth=(), camera=(), geolocation=(self), gyroscope=(), hid=(), magnetometer=(), microphone=(), payment=(), serial=(), usb=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; img-src 'self' data: blob: https://protomaps.github.io https://transit.yesid.dev; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' https://data.yesid.dev https://plausible.io https://protomaps.github.io; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests
