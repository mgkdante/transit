FROM python:3.12.14-slim-bookworm@sha256:782412e85d0f0984994c290652577d4018aff08145c85b262bb63dc0c7522254

ENV PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy \
    PATH="/app/.venv/bin:$PATH"

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && sed -i 's|^mozilla/emSign_ECC_Root_CA_-_G3.crt$|!mozilla/emSign_ECC_Root_CA_-_G3.crt|' /etc/ca-certificates.conf \
    && update-ca-certificates --fresh \
    && rm -rf /var/lib/apt/lists/*
RUN python -c 'import ssl; c=ssl.create_default_context(); n={v for x in c.get_ca_certs() for r in x["subject"] for k,v in r if k=="commonName"}; assert "emSign ECC Root CA - G3" not in n and "ISRG Root X1" in n; assert c.check_hostname and c.verify_mode==ssl.CERT_REQUIRED'

RUN python -m pip install --no-cache-dir \
    "pip @ https://files.pythonhosted.org/packages/3f/06/3e4420302363fbb71be3c7f35ce042f54bfca330e3e66b3a2e3c4cca579f/pip-26.2.2-py3-none-any.whl#sha256=fd7f4dfa8190e014013b9f08f3e973f4e4c26ffd179a204895533a7254813a70" \
    && python -c 'import ssl; from pip._vendor import certifi; c=ssl.create_default_context(cafile=certifi.where()); n={v for x in c.get_ca_certs() for r in x["subject"] for k,v in r if k=="commonName"}; assert "emSign ECC Root CA - G3" not in n and "ISRG Root X1" in n; assert c.check_hostname and c.verify_mode==ssl.CERT_REQUIRED' \
    && python -m pip install --no-cache-dir "uv==0.13.4"

COPY pyproject.toml uv.lock alembic.ini ./
COPY config ./config
COPY src ./src

RUN uv sync --locked --no-dev --group health \
    && adduser --disabled-password --gecos "" --home /app appuser \
    && chown -R appuser:appuser /app

USER appuser

EXPOSE 8080

CMD ["uvicorn", "transit_ops.health.app:app", "--host", "0.0.0.0", "--port", "8080"]
