{
  "name": "transit",
  "private": true,
  "type": "module",
  "description": "Transit operations analytics: Python data pipeline, SvelteKit citizen dashboard and Cloudflare snapshot worker for Montréal and Ottawa.",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "test:changed": "node scripts/test-changed.mjs",
    "test:changed:selection": "node --test scripts/test-changed.test.mjs",
    "setup:hooks": "git config core.hooksPath .githooks",
    "test:commands": "node --test .github/scripts/deploy-commands.test.mjs",
    "dev": "cd apps/web && bun run dev",
    "build": "turbo run build",
    "test": "bun run test:changed:selection && turbo run test",
    "check": "turbo run check",
    "lint": "turbo run lint",
    "deploy:web": "cd apps/web && bun run build && node ../../node_modules/wrangler/bin/wrangler.js deploy",
    "deploy:data-proxy": "bun run --cwd apps/data-proxy deploy",
    "smoke": "bash apps/data-proxy/smoke.sh"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.0",
    "@yesid/config": "https://github.com/yesid-dev/yesid.design/releases/download/v0.40.0-rc.2/yesid-config-0.40.0-rc.2.tgz",
    "turbo": "^2.5.0",
    "wrangler": "4.154.0"
  },
  "engines": {
    "bun": "1.4.4",
    "node": ">=22.17.0 <23"
  },
  "overrides": {
    "@yesid/motion": "https://github.com/yesid-dev/yesid.design/releases/download/v0.40.0-rc.2/yesid-motion-0.40.0-rc.2.tgz",
    "@yesid/seo-kit": "https://github.com/yesid-dev/yesid.design/releases/download/v0.40.0-rc.2/yesid-seo-kit-0.40.0-rc.2.tgz",
    "@yesid/tokens": "https://github.com/yesid-dev/yesid.design/releases/download/v0.40.0-rc.2/yesid-tokens-0.40.0-rc.2.tgz",
    "brace-expansion": "5.0.9",
    "nanoid": "3.3.18",
    "postcss": "8.5.26",
    "undici": "7.29.0",
    "vite": "8.3.5",
    "bits-ui": "2.20.4",
    "@sveltejs/kit": "3.1.1"
  },
  "patchedDependencies": {
    "bits-ui@2.20.4": "patches/bits-ui@2.20.4.patch"
  }
}
