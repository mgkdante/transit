{
	"name": "transit",
	"private": true,
	"type": "module",
	"description": "Transit — STM transit operations analytics turborepo: apps/db (Python pipeline) + apps/web (SvelteKit citizen dashboard) + apps/data-proxy (Cloudflare /v1 snapshot worker).",
	"packageManager": "bun@1.3.11",
	"workspaces": [
		"apps/*"
	],
	"scripts": {
		"setup:hooks": "git config core.hooksPath .githooks",
		"dev": "cd apps/web && bun run dev",
		"build": "turbo run build",
		"test": "turbo run test",
		"check": "turbo run check",
		"lint": "turbo run lint",
		"tokens:build": "bun run --cwd apps/web tokens:build",
		"deploy:web": "cd apps/web && bun run build && bunx wrangler deploy",
		"deploy:data-proxy": "cd apps/data-proxy && bunx wrangler deploy",
		"smoke": "bash apps/data-proxy/smoke.sh"
	},
	"devDependencies": {
		"@yesid/config": "https://github.com/mgkdante/yesid.dev-design/releases/download/config-v0.2.0/yesid-config-v0.2.0.tgz",
		"turbo": "^2.5.0"
	},
	"engines": {
		"bun": ">=1.3.0",
		"node": ">=22.0.0"
	},
	"overrides": {
		"brace-expansion": "5.0.9",
		"nanoid": "3.3.18",
		"postcss": "8.5.26",
		"undici": "7.29.0"
	}
}
