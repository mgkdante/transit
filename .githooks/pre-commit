#!/usr/bin/env bash
# Pre-commit hook — generated-file guards.
# Bypass (last resort, document in the PR): git commit --no-verify
set -euo pipefail

staged() { git diff --cached --name-only --diff-filter=ACM; }

# GUARD 1 — generated OG/icon assets
ASSET_OUTPUT_REGEX='^(apps/web/static/og/.*\.png|apps/web/static/apple-touch-icon-180\.png|apps/web/static/favicon\.svg)$'
ASSET_SOURCE_REGEX='^(apps/web/scripts/build-og\.ts|apps/web/scripts/build-icons\.ts)$'

if staged | grep -qE "$ASSET_OUTPUT_REGEX" && ! staged | grep -qE "$ASSET_SOURCE_REGEX"; then
  echo "ERROR 1/2: A generated OG/icon asset is staged without its generator or input."
  echo "           From apps/web, run 'bun scripts/build-og.ts' or"
  echo "           'bun scripts/build-icons.ts', then stage the output with its"
  echo "           generator."
  echo "           Bypass (last resort): git commit --no-verify"
  exit 1
fi

# GUARD 2 — vendored design system
DESIGN_DIR_REGEX='^apps/web/vendor/design/'
DESIGN_MANIFEST='apps/web/vendor/design/manifest.json'

if staged | grep -qE "$DESIGN_DIR_REGEX" && ! staged | grep -qx "$DESIGN_MANIFEST"; then
  echo "ERROR 2/2: A vendored design-system file is staged without manifest.json."
  echo "           Do not hand-edit vendor/design or run its tool while replacing itself."
  echo "           Use the external exact-tag bootstrap in the web guide:"
  echo "           https://www.notion.so/3ea3e8630690818b935bc88757f8ad4d"
  echo "           Then stage the synced files and manifest together."
  echo "           Bypass (last resort): git commit --no-verify"
  exit 1
fi

exit 0
