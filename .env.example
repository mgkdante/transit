# Transit DB/runtime dotenv template.
#
# From the repository root, copy this file to `apps/db/.env`.
# The Python app, local CLI, and Compose runtime read that file.

# Runtime environment for the local CLI.
APP_ENV=local

# Standard Python logging level.
LOG_LEVEL=INFO

# GitHub Actions requires this secret after pushing the repo if you want the
# included daily static workflow to run successfully:
# - DATABASE_URL
#
# S3/R2 deployment jobs additionally require:
# - BRONZE_S3_ACCESS_KEY
# - BRONZE_S3_SECRET_KEY
#
# Container/runtime secrets required for the realtime worker:
# - DATABASE_URL
# - STM_API_KEY
#
# A realtime worker deployed with S3/R2 storage additionally requires:
# - BRONZE_S3_ACCESS_KEY
# - BRONZE_S3_SECRET_KEY
# The explicit local default does not require R2 credentials.

# Primary Postgres connection string used by db-test, init-db, and seed-core.
DATABASE_URL=

# Compose settings for local validation and Oracle VM Postgres deployments.
# POSTGRES_PASSWORD is required and may contain URL-reserved characters. Compose
# passes it to libpq separately from DATABASE_URL. The host port binds to
# loopback unless an operator deliberately selects a private interface.
POSTGRES_DB=transit
POSTGRES_USER=transit
POSTGRES_PASSWORD=
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_HOST_PORT=5432

# Compose Caddy defaults. Local development binds high host ports by default;
# the Oracle VM cutover can deliberately select another bind and switch the
# published ports to 80/443.
CADDY_SITE_ADDRESS=:80
CADDY_BIND_ADDRESS=127.0.0.1
CADDY_HTTP_PORT=8080
CADDY_HTTPS_PORT=8443

# Default provider timezone for STM and local reporting assumptions.
PROVIDER_TIMEZONE=America/Toronto

# STM provider identifier used across core tables.
STM_PROVIDER_ID=stm

# STM API key is required for live STM GTFS-RT capture.
STM_API_KEY=

# Active static GTFS URL override is optional. The default manifest uses the live
# current STM GTFS archive so realtime trip IDs can join to static stop_times.
STM_STATIC_GTFS_URL=
STM_RT_TRIP_UPDATES_URL=
STM_RT_VEHICLE_POSITIONS_URL=
# Optional URL overrides for the GIS layer feed and the i3 alerts JSON feed.
STM_GIS_URL=
STM_I3_ALERTS_URL=

# Contributor defaults write Bronze objects only under this local root. CI and
# deployment workflows that need durable object storage select s3 explicitly.
BRONZE_STORAGE_BACKEND=local
BRONZE_LOCAL_ROOT=./data/bronze

# S3-compatible Bronze targets are deployment configuration. Use an account-
# level endpoint only, keep the bucket separate, and leave these blank locally.
BRONZE_S3_ENDPOINT=
BRONZE_S3_BUCKET=
BRONZE_S3_ACCESS_KEY=
BRONZE_S3_SECRET_KEY=
BRONZE_S3_REGION=auto

# Nightly logical Postgres backups stream pg_dump (custom format) straight to
# the private Bronze R2 bucket under BACKUP_S3_PREFIX with no VM disk staging.
# BACKUP_EXCLUDE_TABLE_DATA lists tables whose DATA is skipped (schema still
# dumped) because Bronze R2 can replay them; entries must exist in the live
# database or the backup aborts loudly. BACKUP_COMPRESSION is passed verbatim
# to pg_dump --compress (gzip fallback: set to a bare level such as 6).
BACKUP_S3_PREFIX=backups/postgres
BACKUP_RETENTION_COUNT=14
BACKUP_EXCLUDE_TABLE_DATA=silver.rt_trip_update_stop_times
BACKUP_COMPRESSION=zstd:3

# /v1 snapshot publisher. Contributor runs write only to the local root. CI and
# deployment workflows select s3 and provide the bucket/public pointers they
# consume; the S3 path reuses BRONZE_S3_* credentials.
SNAPSHOT_STORAGE_BACKEND=local
SNAPSHOT_R2_BUCKET=
SNAPSHOT_PUBLIC_BASE_URL=
SNAPSHOT_BASEMAP_PMTILES_URL=
SNAPSHOT_BASEMAP_STYLE_URL=
SNAPSHOT_LOCAL_ROOT=./data/snapshots

# Realtime worker cadence controls. The default worker loop targets one
# complete realtime cycle every 30 seconds for live dashboard freshness.
REALTIME_POLL_SECONDS=30
REALTIME_STARTUP_DELAY_SECONDS=0

# Set true to idle the realtime worker loop without stopping the container; the
# worker logs a warning and sleeps one poll interval per loop until set back to
# false.
PIPELINE_PAUSED=false

# Health service checks should fail fast; freshness keeps a 15-minute failure
# window so short STM/API hiccups do not mark the runtime down immediately.
HEALTH_DATABASE_TIMEOUT_SECONDS=5.0
HEALTH_FEED_TIMEOUT_SECONDS=10.0
HEALTH_MAX_PIPELINE_AGE_SECONDS=900
# Runtime VM stats cache window for /health.
HEALTH_RUNTIME_CACHE_SECONDS=30

# Retention defaults for the clean reporting contract: static GTFS keeps one
# current dataset in Silver, Bronze raw static keeps 30 days, Bronze raw
# realtime keeps 90 days (the R2 replay window), Silver realtime keeps 1 day
# (ephemeral staging — raw R2 is the authoritative rebuild source via the
# replay-realtime-silver gate), Gold facts keep 14 days, and Gold
# aggregate/reporting marts keep 730 days.
STATIC_DATASET_RETENTION_COUNT=1
# Global fallback for the static-loader GTFS tolerance. true = a feed missing a
# required non-spine column fails the load loud (STM stays strict). A tolerant
# third-party provider opts in per-manifest via provider.strict_gtfs: false.
STRICT_GTFS=true
SILVER_REALTIME_RETENTION_DAYS=1

GOLD_FACT_RETENTION_DAYS=14

BRONZE_REALTIME_RETENTION_DAYS=90

BRONZE_STATIC_RETENTION_DAYS=30

GOLD_WARM_ROLLUP_RETENTION_DAYS=730

# Bronze pruning stays bounded per invocation while two 5,000-object batches
# provide enough daily capacity for the observed realtime capture volume.
BRONZE_PRUNE_MAX_OBJECTS_PER_BATCH=5000
BRONZE_PRUNE_MAX_BATCHES=2

# i3 alert retention (prune-i3-storage, daily warm-rollups job).
# Raw i3 snapshots + their R2 JSON — the ONLY replay source for collapsed
# silver history once pruned.
BRONZE_I3_RETENTION_DAYS=30
# Closed (valid_to NOT NULL) SCD-2 silver history rows; a 30d floor is enforced
# in code for the alert_history 30d window.
SILVER_I3_CLOSED_RETENTION_DAYS=90
